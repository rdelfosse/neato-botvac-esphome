# Add these to your ESPHome secrets.yaml (never commit the real file).
wifi_ssid: "your-2.4GHz-network"
wifi_password: "your-wifi-password"
# 32-byte base64 key for the native API encryption.
neato_api_key: "generate-one-with-openssl-rand-base64-32"
# Password of the fallback hotspot the ESP opens when Wi-Fi is unreachable (8 characters minimum).
neato_fallback_password: "choose-a-password"
